# vSlam 导航包环境变量配置示例
# 使用方法：复制本文件为 .env 并填写实际值，然后在 shell 中 source .env
# 或在启动脚本前 export 对应变量

# ============================================================================
# 工作空间路径配置
# ============================================================================

# x86 端工作空间根目录（包含 server.py, odom.py, action/ 等）
export X86_WS_DIR="$HOME/ros2ws"

# ARM 端工作空间根目录（包含 ros_client.py, time.py, scripts/ 等）
export ARM_WS_DIR="$HOME/code"

# Orbbec 相机驱动工作空间
export ORBBEC_WS_DIR="$HOME/orbbec_camera_ros2"

# 由各家相机驱动实现的 launch 文件名
export ORBBEC_LAUNCH_FILE="slam_330.launch.py"

# 默认禁用需要系统权限的 IMU 时间同步；完成 sudoers 配置后再设为 1
export ENABLE_TIME_SYNC="0"

# 语音相关包工作空间
export ABCDVOICE_WS_DIR="$HOME/Documents/abcdvoice/fish"

# 讲解词音频文件目录
export WAV_DIR="$PWD/wav"

# ============================================================================
# 网络服务配置
# ============================================================================

# UDP 指令监听端口（中控模块发送指令端口）
export UDP_CMD_PORT="5005"

# 语音采集 socket 服务地址
export AUDIO_SOCKET_IP="127.0.0.1"
export AUDIO_SOCKET_PORT="9080"

# 大模型/ASR 服务地址
export LLM_SERVER_IP="127.0.0.1"
export LLM_SERVER_PORT="5006"

# 大模型服务鉴权 Token（必填，请勿提交真实 Token 到代码仓库）
export LLM_API_TOKEN="your_token_here"
